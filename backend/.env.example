# Copy this file to .env and fill in your key.
#
# Option A (default) -- Claude API. Get a key from https://platform.claude.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B -- free, no-card alternative. Get a key from https://aistudio.google.com,
# then uncomment both lines below (and you can leave ANTHROPIC_API_KEY blank).
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-key-here

# Optional overrides:
# DATA_AGENT_MODEL=claude-sonnet-5
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=true
